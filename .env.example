# Second Brain OS — environment configuration
# Copy to .env and adjust. Everything has a working local default.

# --- Core ---
SECRET_KEY=dev-only-secret-key-change-me
# Fernet key for encrypting OAuth tokens at rest:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# --- Database (docker compose exposes on host port 5433) ---
DATABASE_URL=postgresql+psycopg://secondbrain:secondbrain@localhost:5433/secondbrain

# --- LLM (any OpenAI-compatible endpoint; default = local MLX server) ---
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=
LLM_EXTRACTION_MODEL=fast
LLM_REASONING_MODEL=smart
LLM_CLASSIFY_MODEL=fast
LLM_SUMMARIZE_MODEL=fast
# Embeddings + reranking via the local-ai stack (~/ai) — same server as the LLM.
EMBEDDING_PROVIDER=localai
EMBEDDING_DIM=1024
RERANKER_ENABLED=true

# --- Google Calendar OAuth (optional — adapter stays dormant without these) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Google: Meet links work with the Calendar scopes above. Gmail drafts are OPT-IN because
#     they need the restricted gmail.compose scope: set true, then reconnect Google.
#     Drafts only — the code never sends. ---
GOOGLE_GMAIL_DRAFTS=false

# --- Zoom (optional): Server-to-Server OAuth app from the Zoom Marketplace ---
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- Apple Reminders / Calendar / Mail drafts / Shortcuts via osascript (macOS only) ---
# macOS asks for Automation permission the first time each app is used.
APPLE_ENABLED=false
# Name of the Calendar.app calendar new meetings are added to (Apple Calendar provider).
APPLE_CALENDAR_NAME=Calendar

# --- PMAX file engine (auto-detected on PATH or ~/.local/bin/pmax) ---
# PMAX_BIN=/usr/local/bin/pmax

# --- Web ---
FRONTEND_ORIGINS=["http://localhost:3000"]
